<?xml version="1.0" ?>
<!--
  AgriBot field world for Gazebo Sim (Fortress): an open field with scattered
  trees of various sizes, for the SLAM + Nav2 mobile-harvest demo. The robot is
  spawned separately (agribot_description). Sensors system is enabled for the
  robot's gpu_lidar.
-->
<sdf version="1.8">
  <world name="field">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.4 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.3 0.45 0.3 1</ambient><diffuse>0.32 0.48 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Scattered trees (trunk = lidar-visible obstacle; canopy for looks),
         drivably spaced (>1.5 m apart). -->
    <!-- tree_0 --><model name="tree_0"><static>true</static><pose>2.0 1.2 0 0 0 0</pose><link name="l"><collision name="c"><pose>0 0 0.7 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>1.4</length></cylinder></geometry></collision><visual name="t"><pose>0 0 0.7 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>1.4</length></cylinder></geometry><material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.35 0.2 0.05 1</diffuse></material></visual><visual name="cn"><pose>0 0 1.6 0 0 0</pose><geometry><sphere><radius>0.5</radius></sphere></geometry><material><ambient>0.15 0.4 0.15 1</ambient><diffuse>0.15 0.4 0.15 1</diffuse></material></visual></link></model>
    <!-- tree_1 --><model name="tree_1"><static>true</static><pose>3.6 -0.8 0 0 0 0</pose><link name="l"><collision name="c"><pose>0 0 0.6 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>1.2</length></cylinder></geometry></collision><visual name="t"><pose>0 0 0.6 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>1.2</length></cylinder></geometry><material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.35 0.2 0.05 1</diffuse></material></visual><visual name="cn"><pose>0 0 1.35 0 0 0</pose><geometry><sphere><radius>0.42</radius></sphere></geometry><material><ambient>0.15 0.4 0.15 1</ambient><diffuse>0.15 0.4 0.15 1</diffuse></material></visual></link></model>
    <!-- tree_2 --><model name="tree_2"><static>true</static><pose>2.6 -2.4 0 0 0 0</pose><link name="l"><collision name="c"><pose>0 0 0.8 0 0 0</pose><geometry><cylinder><radius>0.10</radius><length>1.6</length></cylinder></geometry></collision><visual name="t"><pose>0 0 0.8 0 0 0</pose><geometry><cylinder><radius>0.10</radius><length>1.6</length></cylinder></geometry><material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.35 0.2 0.05 1</diffuse></material></visual><visual name="cn"><pose>0 0 1.8 0 0 0</pose><geometry><sphere><radius>0.55</radius></sphere></geometry><material><ambient>0.15 0.4 0.15 1</ambient><diffuse>0.15 0.4 0.15 1</diffuse></material></visual></link></model>
    <!-- tree_3 --><model name="tree_3"><static>true</static><pose>5.0 1.6 0 0 0 0</pose><link name="l"><collision name="c"><pose>0 0 0.65 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>1.3</length></cylinder></geometry></collision><visual name="t"><pose>0 0 0.65 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>1.3</length></cylinder></geometry><material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.35 0.2 0.05 1</diffuse></material></visual><visual name="cn"><pose>0 0 1.45 0 0 0</pose><geometry><sphere><radius>0.46</radius></sphere></geometry><material><ambient>0.15 0.4 0.15 1</ambient><diffuse>0.15 0.4 0.15 1</diffuse></material></visual></link></model>
    <!-- tree_4 --><model name="tree_4"><static>true</static><pose>5.2 -1.4 0 0 0 0</pose><link name="l"><collision name="c"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>1.5</length></cylinder></geometry></collision><visual name="t"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>1.5</length></cylinder></geometry><material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.35 0.2 0.05 1</diffuse></material></visual><visual name="cn"><pose>0 0 1.7 0 0 0</pose><geometry><sphere><radius>0.52</radius></sphere></geometry><material><ambient>0.15 0.4 0.15 1</ambient><diffuse>0.15 0.4 0.15 1</diffuse></material></visual></link></model>
    <!-- tree_5 --><model name="tree_5"><static>true</static><pose>1.6 -0.6 0 0 0 0</pose><link name="l"><collision name="c"><pose>0 0 0.55 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>1.1</length></cylinder></geometry></collision><visual name="t"><pose>0 0 0.55 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>1.1</length></cylinder></geometry><material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.35 0.2 0.05 1</diffuse></material></visual><visual name="cn"><pose>0 0 1.25 0 0 0</pose><geometry><sphere><radius>0.4</radius></sphere></geometry><material><ambient>0.15 0.4 0.15 1</ambient><diffuse>0.15 0.4 0.15 1</diffuse></material></visual></link></model>
    <!-- tree_6 --><model name="tree_6"><static>true</static><pose>6.4 0.4 0 0 0 0</pose><link name="l"><collision name="c"><pose>0 0 0.7 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>1.4</length></cylinder></geometry></collision><visual name="t"><pose>0 0 0.7 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>1.4</length></cylinder></geometry><material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.35 0.2 0.05 1</diffuse></material></visual><visual name="cn"><pose>0 0 1.6 0 0 0</pose><geometry><sphere><radius>0.5</radius></sphere></geometry><material><ambient>0.15 0.4 0.15 1</ambient><diffuse>0.15 0.4 0.15 1</diffuse></material></visual></link></model>
    <!-- tree_7 --><model name="tree_7"><static>true</static><pose>4.0 2.6 0 0 0 0</pose><link name="l"><collision name="c"><pose>0 0 0.6 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>1.2</length></cylinder></geometry></collision><visual name="t"><pose>0 0 0.6 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>1.2</length></cylinder></geometry><material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.35 0.2 0.05 1</diffuse></material></visual><visual name="cn"><pose>0 0 1.35 0 0 0</pose><geometry><sphere><radius>0.44</radius></sphere></geometry><material><ambient>0.15 0.4 0.15 1</ambient><diffuse>0.15 0.4 0.15 1</diffuse></material></visual></link></model>
  </world>
</sdf>

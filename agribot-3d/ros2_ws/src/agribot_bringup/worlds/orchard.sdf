<?xml version="1.0" ?>
<!--
  AgriBot orchard world for Gazebo Sim (Fortress / gz-sim 6).

  The UR5e is spawned into this world at the origin by ur_sim_control.launch.py.
  Everything is defined inline (no Fuel model:// includes) so it works offline.

  Layout is a modern "fruiting wall" / trellis orchard (high-density planting,
  which is what ag-robotics actually targets): trunks stand in a row at y=+0.42
  and the fruit hangs in front of them at y~0.15-0.25, all inside the UR5e's
  ~0.85 m reach. An RGB-D camera on a static mast looks along +y at the wall
  (eye-to-hand), so the arm never occludes it.

  Fruit is RED (ripe, with varying redness) or GREEN (unripe). The perception
  stack picks out only the red ones; redness sets the safe grip force
  (tolerance = 1 - redness).

  Systems:
    Physics          — rigid-body dynamics
    SceneBroadcaster — scene/pose state (Foxglove, ros_gz bridge)
    UserCommands     — /world/orchard/create|remove|set_pose services
    Sensors          — renders the camera (ogre2; CPU/llvmpipe in Docker)
-->
<sdf version="1.8">
  <world name="orchard">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.5 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.3 0.45 0.3 1</ambient>
            <diffuse>0.35 0.5 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= RGB-D camera mast (eye-to-hand) =================
         Sits at y=-0.9 looking along +y at the fruiting wall, tilted ~12 deg
         down. Publishes gz topics: /camera/image, /camera/depth_image,
         /camera/points, /camera/camera_info (bridged to ROS by ros_gz_bridge).
         Kept outside the arm's reach so it can't be struck. -->
    <model name="camera_mast">
      <static>true</static>
      <pose>0.45 -0.9 0 0 0 0</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 0.47 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.95</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
        <visual name="head">
          <pose>0 0 0.95 0 0.21 1.5708</pose>
          <geometry><box><size>0.06 0.10 0.05</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <sensor name="rgbd" type="rgbd_camera">
          <!-- gz camera frame: +x forward, +z up. yaw=90deg points it at +y. -->
          <pose>0 0 0.95 0 0.21 1.5708</pose>
          <!-- Stamp images/clouds with this frame so tf2 can place detections.
               A static transform base_link -> camera_optical_frame is published
               in perception.launch.py. -->
          <ignition_frame_id>camera_optical_frame</ignition_frame_id>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>camera</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>6.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- ===== Trellis posts (the "fruiting wall" backdrop / obstacles) ===== -->
    <model name="tree_trunk_1">
      <static>true</static>
      <pose>0.25 0.42 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>1.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>1.4</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.35 0.2 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_trunk_2">
      <static>true</static>
      <pose>0.75 0.42 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>1.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>1.4</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.05 1</ambient><diffuse>0.35 0.2 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== FRUIT =====================
         RED (ripe) — name encodes redness for the grip-force rule:
           fruit_red_090 -> redness 0.90 -> tolerance 0.10 (most fragile)
         GREEN (unripe) — must be left alone.
         All within the UR5e's reach from the base at the origin. -->
    <model name="fruit_red_090">
      <static>true</static>
      <pose>0.45 0.20 0.70 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.035</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material><ambient>0.75 0.03 0.03 1</ambient><diffuse>0.88 0.05 0.04 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="fruit_red_065">
      <static>true</static>
      <pose>0.58 0.18 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.035</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material><ambient>0.72 0.20 0.04 1</ambient><diffuse>0.85 0.28 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="fruit_red_080">
      <static>true</static>
      <pose>0.30 0.22 0.80 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.035</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material><ambient>0.75 0.08 0.04 1</ambient><diffuse>0.87 0.12 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="fruit_green_1">
      <static>true</static>
      <pose>0.52 0.16 0.85 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.035</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material><ambient>0.25 0.55 0.12 1</ambient><diffuse>0.35 0.68 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="fruit_green_2">
      <static>true</static>
      <pose>0.36 0.18 0.52 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.035</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material><ambient>0.25 0.55 0.12 1</ambient><diffuse>0.35 0.68 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

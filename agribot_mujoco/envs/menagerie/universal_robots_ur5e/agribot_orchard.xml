<mujoco model="agribot orchard reach">
  <!--
    AgriBot RL scene (project file, not part of upstream Menagerie).
    Lives in the ur5e/ directory so the included ur5e.xml resolves its
    meshdir="assets" relative to this file's location.

    Contents beyond the bare UR5e:
      - ground plane + sky (copied from Menagerie scene.xml)
      - "trunk": a static cylinder obstacle (the tree)
      - "fruit": a MOCAP body (red sphere) we teleport each episode via
        data.mocap_pos — kinematic, so no physics tuning needed for a target
      - a light

    The TCP reference is ur5e.xml's <site name="attachment_site"> at the flange.
  -->
  <include file="ur5e.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.2 0.2 0.2" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.25" rgb2="0.1 0.2 0.15"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="bark" rgba="0.35 0.20 0.05 1"/>
    <material name="fruit_red" rgba="0.85 0.08 0.08 1" specular="0.4" shininess="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.0" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Tree trunk: static obstacle in front-left of the arm. -->
    <body name="trunk" pos="0.55 0.35 0.5">
      <geom name="trunk_geom" type="cylinder" size="0.06 0.5" material="bark"/>
    </body>

    <!-- Fruit target: mocap body, repositioned each episode. Default pose is
         overwritten by FruitReachEnv.reset(); keep it inside the workspace. -->
    <body name="fruit" mocap="true" pos="0.5 0.15 0.6">
      <geom name="fruit_geom" type="sphere" size="0.04" material="fruit_red"
            contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
